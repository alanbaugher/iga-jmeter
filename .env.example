# IGA benchmark configuration
DEPLOYMENT=IGA

IM_HOST=127.0.0.1
IM_PORT=8443
IM_ENV=identityEnv
IM_ORG=im

IM_USER=igx
IM_PASS=CHANGE_ME

USERS=10
SECONDS_PER_PHASE=60
EXTRA=0
CLEANUP_WORKERS=32

JMETER="$PWD/iga_benchmark/apache-jmeter-5.6.3/bin/jmeter"

IGA_LOGS_ROOT=/opt/brcm/iga/logs
LOG_PADDING_SECONDS=15

SERVER_TZ=America/Chicago
ROUTER_TZ=America/Chicago
USTORE_TZ=America/Chicago
