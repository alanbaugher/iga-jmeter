              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Check 09 Confirm update once" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
if (prev.getResponseCode() != '200') throw new IllegalStateException('Expected HTTP 200')
def doc = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())
def form = doc.selectFirst('form#main')
if (!doc.text().contains('Task completed.')) throw new IllegalStateException('Expected Task completed. Check task status before retrying the write.')

def bench=props.get('im.bench.state')
def elapsed=System.nanoTime()-bench.start.get('modify')
def window=(props.getProperty('seconds','60') as long)*1000000000L
def event='[IM-BENCH] MODIFIED id='+vars.get('targetUser')+' elapsedMs='+elapsed.intdiv(1000000L)+' window='+(elapsed&lt;window?'IN':'LATE')
log.info(event); System.out.println(event)

} catch(Exception ex) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(ex.getMessage() ?: 'Form check failed')
}</stringProp>
