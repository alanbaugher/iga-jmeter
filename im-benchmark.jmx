              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">if (!(prev.getResponseCode() == '200' &amp;&amp; prev.getResponseDataAsString().toLowerCase().contains('href="?logout=1"'))) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Authenticated console marker missing') }
</stringProp>
            </JSR223Assertion>
            <hashTree />
          </hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Announce request" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (props.getProperty('verbose', 'true').toBoolean()) {
    def line = "[IM-LOGIN] ${java.time.Instant.now()} START thread=${ctx.getThread().getThreadName()} | ${sampler.getName()}"
    System.out.println(line)
    log.info(line)
}</stringProp>
          </JSR223PreProcessor>
          <hashTree />
          <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Report completed request" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (props.getProperty('verbose', 'true').toBoolean()) {
    def r = sampleResult
    def verdict = r.isSuccessful() ? 'PASS' : 'FAIL'
    def http = r.getResponseCode() ==~ /[0-9]{3}/ ? r.getResponseCode() : 'transport-error'
    def failed = r.getAssertionResults().findAll { it.isFailure() || it.isError() }.collect { it.getName() }
    def detail = failed ? ' | failed check: ' + failed.join(', ') : ''
    def line = "[IM-LOGIN] ${java.time.Instant.now()} ${verdict} thread=${r.getThreadName()} | ${r.getSampleLabel()} | HTTP ${http} | elapsed=${r.getTime()}ms${detail}"
    System.out.println(line)
    log.info(line)
}</stringProp>
          </JSR223Listener>
          <hashTree />
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Initialize fixture work queue" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def s=props.get('im.bench.state')
if(!s?.ready) throw new IllegalStateException('No preflight')
synchronized(s.lock) {
 if(s.seedQuota==null) s.seedQuota=new java.util.concurrent.atomic.AtomicInteger(props.getProperty('extra','0') as int)
}
vars.put('seedLoop','true')</stringProp>
          </JSR223Sampler>
          <hashTree />
          <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Allocate extra accounts" enabled="true">
            <stringProp name="WhileController.condition">${seedLoop}</stringProp>
          </WhileController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Claim extra fixture ID" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def s=props.get('im.bench.state')
def id=s.seedQuota.getAndDecrement()&gt;0 ? s.ids.poll() : null
vars.put('hasSeed',String.valueOf(id!=null));vars.put('seedLoop',String.valueOf(id!=null))
if(id){
 vars.put('targetUser',id);vars.put('org',props.getProperty('org','im'));vars.put('benchMarker',s.marker)
 vars.put('accountPwd',System.getenv('IM_NEW_USER_PASS') ?: ('Jm!9a'+UUID.randomUUID().toString()))
}</stringProp>
            </JSR223Sampler>
            <hashTree />
            <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Create claimed extra fixture" enabled="true">
              <stringProp name="IfController.condition">${hasSeed}</stringProp>
              <boolProp name="IfController.useExpression">true</boolProp>
            </IfController>
