          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="01 Get fresh login session" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments" />
            </elementProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.domain">${__P(host,192.168.2.130)}</stringProp>
            <stringProp name="HTTPSampler.port">${__P(port,8443)}</stringProp>
            <stringProp name="HTTPSampler.path">/iam/im/${__P(env,identityEnv)}/</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
            <stringProp name="HTTPSampler.response_timeout">45000</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Require login form and supplied credentials" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def user = System.getenv('IM_USER') ?: ''
def pass = System.getenv('IM_PASS') ?: ''
vars.put('imUser', user)
vars.put('imPass', pass)
def reason = ''
if (!user) reason = 'IM_USER missing in JMeter process'
else if (!pass) reason = 'IM_PASS missing in JMeter process'
else if (prev.getResponseCode() != '200') reason = 'Initial GET returned ' + prev.getResponseCode()
else {
    def doc = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())
    def fields = doc.select('form input')
    def password = fields.any { it.attr('type').equalsIgnoreCase('password') || it.attr('name').equalsIgnoreCase('password') }
    if (!password) {
        def u = prev.getURL()
        def location = u == null ? '(unknown)' : u.getHost() + u.getPath().split(';')[0]
        reason = 'No password input in returned HTML; final host/path=' + location + ', forms=' + doc.select('form').size() + ', sign-out link=' + (doc.select('a[href*=logout]').size()&gt;0)
    }
}
if (reason) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(reason)
    log.warn('[IM-PREFLIGHT] ' + reason)
}</stringProp>
            </JSR223Assertion>
