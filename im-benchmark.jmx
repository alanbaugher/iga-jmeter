                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
if (prev.getResponseCode() != '200') throw new IllegalStateException('Expected HTTP 200')
def doc = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())
def form = doc.selectFirst('form#main')
if (form == null || !form.attr('action').equals('?facesViewId=/app/page/screen/standard_search.jsp')) {
    def forms = doc.select('form[id]').collect { it.id().replaceAll(/[^a-zA-Z0-9_:-]/,'_').take(50) }.take(4)
    def actual = form?.attr('action') ?: ''
    def route = (actual =~ /[?&amp;]facesViewId=(\/app\/[a-zA-Z0-9_\/-]+\.jsp)(?:$|[&amp;#])/)
    def observed = route.find() ? route.group(1) : 'unknown'
    throw new IllegalStateException("Form mismatch | target="+(vars.get('targetUser') ?: 'n/a')+" | HTTP="+prev.getResponseCode()+" | expected=form#main /app/page/screen/standard_search.jsp | observedView="+observed+" | formIds="+forms)
}
def token = form.selectFirst('input[name=OWASP_CSRFTOKEN]')?.val()
if (!token) throw new IllegalStateException('Missing CSRF token')
vars.put('csrf',token)
def hits=form.select('input[name=DefaultUserSearch__sel]').findAll { it.attr('title') == 'Select "' + vars.get('targetUser') + '"' }
if (hits.size()!=1) throw new IllegalStateException('Exact search mismatch | target='+vars.get('targetUser')+' | HTTP='+prev.getResponseCode()+' | expected=1 | matches='+hits.size())
vars.put('selection',hits[0].val())

} catch(Exception ex) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(ex.getMessage() ?: 'Form check failed')
}</stringProp>
