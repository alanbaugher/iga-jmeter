      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Start cleanup clock" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def s=props.get('im.bench.state')
if(!s?.ready) throw new IllegalStateException('Preflight did not finish')
s.cleanupStart=System.nanoTime()
vars.putObject('ids',new TreeSet())
def uncertain=new TreeSet(s.attempted); uncertain.removeAll(s.owned.keySet())
vars.put('needInventory',String.valueOf(!uncertain.isEmpty()))
</stringProp>
        </JSR223Sampler>
        <hashTree />
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Inventory uncertain creates" enabled="true">
          <stringProp name="IfController.condition">${needInventory}</stringProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
