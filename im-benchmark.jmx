              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Check 07 Open and verify target profile" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
if (prev.getResponseCode() != '200') throw new IllegalStateException('Expected HTTP 200')
def doc = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())
def form = doc.selectFirst('form#main')
if (form == null || !form.attr('action').equals('?facesViewId=/app/page/profile/profile.jsp')) {
    def forms = doc.select('form[id]').collect { it.id().replaceAll(/[^a-zA-Z0-9_:-]/,'_').take(50) }.take(4)
    def actual = form?.attr('action') ?: ''
    def route = (actual =~ /[?&amp;]facesViewId=(\/app\/[a-zA-Z0-9_\/-]+\.jsp)(?:$|[&amp;#])/)
    def observed = route.find() ? route.group(1) : 'unknown'
    throw new IllegalStateException("Form mismatch | target="+(vars.get('targetUser') ?: 'n/a')+" | HTTP="+prev.getResponseCode()+" | expected=form#main /app/page/profile/profile.jsp | observedView="+observed+" | formIds="+forms)
}
def token = form.selectFirst('input[name=OWASP_CSRFTOKEN]')?.val()
if (!token) throw new IllegalStateException('Missing CSRF token')
vars.put('csrf',token)
if (form.selectFirst('input[name=LOGIN_ID]')?.val()!=vars.get('targetUser') || form.selectFirst('input[name=TITLE]')==null) throw new IllegalStateException('Profile identity or TITLE mismatch')
def names = 'LOGIN_ID NAME_PREFIX FIRST_NAME MIDDLE_NAME LAST_NAME NAME_SUFFIX FULL_NAME NAME_ALIAS EMAIL TITLE MANAGER EMPLOYEE_TYPE EMPLOYEE_NUMBER ACTIVATION_DATE EXPIRATION_DATE'.split(' ')
for (name in names) {
    def el=form.selectFirst('input[name='+name+']')
    if (el==null || el.hasAttr('disabled')) throw new IllegalStateException('Profile differs from recording at '+name)
    vars.put('field_'+name,el.val())
}
def enabled=form.selectFirst('input[name=enable]')
if (enabled==null) throw new IllegalStateException('Missing enabled-state checkbox')
vars.put('wasEnabled', String.valueOf(enabled.hasAttr('checked') &amp;&amp; !enabled.hasAttr('disabled')))
vars.put('enableValue', enabled.val())

} catch(Exception ex) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(ex.getMessage() ?: 'Form check failed')
}</stringProp>
              </JSR223Assertion>
