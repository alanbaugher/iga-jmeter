                <stringProp name="script">try {
if (prev.getResponseCode() != '200') throw new IllegalStateException('Expected HTTP 200')
def doc = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())
def form = doc.selectFirst('form#main')
def action=form?.attr('action')
if (!(action in ['?facesViewId=/app/page/screen/standard_search.jsp','?facesViewId=/app/page/profile/profile.jsp'])) throw new IllegalStateException('Unexpected Create User form action')
def token=form.selectFirst('input[name=OWASP_CSRFTOKEN]')?.val()
if(!token) throw new IllegalStateException('Missing token')
vars.put('csrf',token)
vars.put('createPath',action)
def org=form.selectFirst('input[name=ORG_MEMBERSHIP]')
if(org==null) throw new IllegalStateException('Expected organization field')
vars.put('needOrg',String.valueOf(org.val()!=vars.get('org')))

} catch(Exception ex) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(ex.getMessage() ?: 'Form check failed')
}</stringProp>
