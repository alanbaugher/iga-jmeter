        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Open cleanup queue" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def s=props.get('im.bench.state')
if(s?.cleanupQueue==null) throw new IllegalStateException('Cleanup queue unavailable')
vars.put('scanWork','true')</stringProp>
