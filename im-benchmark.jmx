            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Check Confirm create once" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
if (prev.getResponseCode() != '200') throw new IllegalStateException('Expected HTTP 200')
def doc = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())
def form = doc.selectFirst('form#main')
if (!doc.text().contains('Task completed.')) throw new IllegalStateException('IM did not report Task completed; inspect task status before retrying')
def line = '[IM-CREATED] '+vars.get('targetUser')
log.info(line); System.out.println(line)

props.get('im.bench.state').owned.put(vars.get('targetUser'),Boolean.TRUE)
def bench=props.get('im.bench.state')
def elapsed=System.nanoTime()-bench.start.get('create')
def window=(props.getProperty('seconds','60') as long)*1000000000L
def event='[IM-BENCH] CREATED id='+vars.get('targetUser')+' elapsedMs='+elapsed.intdiv(1000000L)+' window='+(elapsed&lt;window?'IN':'LATE')
log.info(event); System.out.println(event)

} catch(Exception ex) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(ex.getMessage() ?: 'Form check failed')
}</stringProp>
