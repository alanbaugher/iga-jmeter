          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">vars.putObject('prefixes',new ArrayDeque(['jmeter_test_']))
vars.put('scanMore','true')
vars.getObject('ids').clear()
</stringProp>
        </JSR223Sampler>
