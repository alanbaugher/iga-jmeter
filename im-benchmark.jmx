        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Reserve unused account names" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def s=props.get('im.bench.state')
def existing=vars.getObject('ids')
def free=(1..9999).collect {String.format(java.util.Locale.ROOT,'jmeter_test_%04d',it)}.findAll{!existing.contains(it)}
if(free.isEmpty()) throw new IllegalStateException('No unused numbered IDs remain')
s.ids=new java.util.concurrent.ConcurrentLinkedQueue(free)
s.freeCount=free.size()
s.ready=true
def msg = '[IM-BENCH] PREFLIGHT free='+s.freeCount+' excluded='+existing.size()+' marker='+s.marker; log.info(msg); System.out.println(msg)</stringProp>
