        <hashTree />
        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Report completed request" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">if (props.getProperty('verbose', 'true').toBoolean()) {
    def r = sampleResult
    def verdict = r.isSuccessful() ? 'PASS' : 'FAIL'
    def http = r.getResponseCode() ==~ /[0-9]{3}/ ? r.getResponseCode() : 'transport-error'
    def failed = r.getAssertionResults().findAll { it.isFailure() || it.isError() }.collect { it.getName() }
    def detail = failed ? ' | failed check: ' + failed.join(', ') : ''
    def line = "[IM-LOGIN] ${java.time.Instant.now()} ${verdict} thread=${r.getThreadName()} | ${r.getSampleLabel()} | HTTP ${http} | elapsed=${r.getTime()}ms${detail}"
    System.out.println(line)
    log.info(line)
}</stringProp>
        </JSR223Listener>
        <hashTree />
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Synchronize workers for modify" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def s=props.get('im.bench.state')
if(!s?.ready) throw new IllegalStateException('Preflight failed')
def n=props.getProperty('users','10') as int
def p='modify'
def gate
synchronized(s.lock){
  if(s[p+'Gate']==null){
    if(p=='modify') s.mods=new java.util.concurrent.ConcurrentLinkedQueue(new TreeSet(s.owned.keySet()))
    gate=new java.util.concurrent.CyclicBarrier(n, {
      s.start.put(p,System.nanoTime())
      def msg='[IM-BENCH] START phase='+p+' seconds='+props.getProperty('seconds','60')
      log.info(msg); System.out.println(msg)
    } as Runnable)
    s[p+'Gate']=gate
  }
  gate=s[p+'Gate']
}
gate.await(90,java.util.concurrent.TimeUnit.SECONDS)
vars.put('loop','true')</stringProp>
        </JSR223Sampler>
        <hashTree />
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Run until deadline or pool exhaustion" enabled="true">
          <stringProp name="WhileController.condition">${loop}</stringProp>
        </WhileController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Claim next modify target" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def s=props.get('im.bench.state')
def p='modify'
long span=(props.getProperty('seconds','60') as long)*1000000000L
def id=(System.nanoTime()-s.start.get(p)&lt;span) ? (p=='create' ? s.ids : s.mods).poll() : null
if (id==null &amp;&amp; System.nanoTime()-s.start.get(p)&lt;span) {
  synchronized(s.lock){
    if(!s[p+'Exhausted']){
       s[p+'Exhausted']=true
       def msg='[IM-BENCH] EXHAUSTED phase='+p+' elapsedMs='+(System.nanoTime()-s.start.get(p)).intdiv(1000000L)
       log.info(msg);System.out.println(msg)
    }
  }
}
if(id &amp;&amp; System.nanoTime()-s.start.get(p)&gt;=span) id=null
vars.put('hasTarget',Boolean.toString(id!=null));vars.put('loop',Boolean.toString(id!=null))
if(id!=null) {
 vars.put('targetUser',id);vars.put('org',props.getProperty('org','im'))
 if(p=='create') vars.put('accountPwd',System.getenv('IM_NEW_USER_PASS') ?: ('Jm!9a'+UUID.randomUUID().toString()))
}</stringProp>
          </JSR223Sampler>
