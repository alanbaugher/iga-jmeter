        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Announce request" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">if (props.getProperty('verbose', 'true').toBoolean()) {
    def line = "[IM-LOGIN] ${java.time.Instant.now()} START thread=${ctx.getThread().getThreadName()} | ${sampler.getName()}"
    System.out.println(line)
    log.info(line)
}</stringProp>
        </JSR223PreProcessor>
        <hashTree />
        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Report completed request" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">if (props.getProperty('verbose', 'true').toBoolean()) {
    def r = sampleResult
    def verdict = r.isSuccessful() ? 'PASS' : 'FAIL'
    def http = r.getResponseCode() ==~ /[0-9]{3}/ ? r.getResponseCode() : 'transport-error'
    def failed = r.getAssertionResults().findAll { it.isFailure() || it.isError() }.collect { it.getName() }
    def detail = failed ? ' | failed check: ' + failed.join(', ') : ''
    def line = "[IM-LOGIN] ${java.time.Instant.now()} ${verdict} thread=${r.getThreadName()} | ${r.getSampleLabel()} | HTTP ${http} | elapsed=${r.getTime()}ms${detail}"
    System.out.println(line)
    log.info(line)
}</stringProp>
        </JSR223Listener>
        <hashTree />
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Initialize run ledger" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def n = props.getProperty('users','10') as int
def secs = props.getProperty('seconds','60') as int
if (!(n in 1..999) || !(secs in 1..3600)) throw new IllegalArgumentException('Invalid USERS or SECONDS')
def state=[
  owned:new java.util.concurrent.ConcurrentHashMap(),
  attempted:java.util.concurrent.ConcurrentHashMap.newKeySet(),
  deleted:java.util.concurrent.ConcurrentHashMap.newKeySet(),
  lock:new Object(), start: new java.util.concurrent.ConcurrentHashMap(), marker:'JM'+UUID.randomUUID().toString().replace('-','').take(12),
  ids:null, ready:false]
props.put('im.bench.state',state)
vars.putObject('ids',new TreeSet())</stringProp>
        </JSR223Sampler>
        <hashTree />
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Inventory initialize scan" enabled="true">
