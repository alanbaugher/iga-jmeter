            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify expected redirect" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def location = prev.getRedirectLocation()
def from = prev.getURL().toURI()
def next = location ? from.resolve(location) : null
def want = '/iam/im/' + props.getProperty('env','identityEnv') + '/index.jsp'
if (!(prev.getResponseCode() == '302' &amp;&amp; next?.authority == from.authority &amp;&amp; next?.scheme == 'https' &amp;&amp; next?.path == want)) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Unexpected redirect') }</stringProp>
            </JSR223Assertion>
