}
def token = form.selectFirst('input[name=OWASP_CSRFTOKEN]')?.val()
if (!token) throw new IllegalStateException('Missing CSRF token')
vars.put('csrf',token)

def boxes=form.select('input[type=checkbox][name^=DefaultUserSearchSelect_]')
def id=vars.get('targetUser')
if (boxes.size()!=1 || boxes[0].attr('title')!='Select "'+id+'"' || boxes[0].closest('tr').select('td').get(1).text()!=id || !(boxes[0].attr('name') ==~ /DefaultUserSearchSelect_[0-9]+/)) throw new IllegalStateException('Exact deletion target mismatch')
vars.put('deleteBox',boxes[0].attr('name'))

} catch(Exception ex) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(ex.getMessage() ?: 'Form check failed')
}</stringProp>
