        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Publish unique deletion candidates" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def s=props.get('im.bench.state')
def targets=new TreeSet(s.owned.keySet())
if(vars.get('needInventory')=='true'){
    def visible=new TreeSet(vars.getObject('ids')); visible.retainAll(s.attempted)
    targets.addAll(visible)
}
s.cleanupCount=targets.size()
s.cleanupQueue=new java.util.concurrent.ConcurrentLinkedQueue(targets)
def msg='[IM-BENCH] CLEANUP_START candidates='+targets.size()+' workers='+props.getProperty('deleteWorkers','32')
log.info(msg);System.out.println(msg)
</stringProp>
        </JSR223Sampler>
