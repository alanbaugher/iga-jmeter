          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Claim one unique deletion" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def s=props.get('im.bench.state')
def id=s.cleanupQueue.poll()
if(id!=null &amp;&amp; (!(id ==~ /jmeter_test_(?!0000)[0-9]{4}/) || id.equalsIgnoreCase(System.getenv('IM_USER')) || !s.attempted.contains(id))) throw new IllegalStateException('Ineligible cleanup target')
vars.put('scanWork',Boolean.toString(id!=null))
if(id!=null) vars.put('targetUser',id)
</stringProp>
          </JSR223Sampler>
