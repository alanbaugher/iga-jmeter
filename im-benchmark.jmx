        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Verify cleanup and close run" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def s=props.get('im.bench.state')
def left=new TreeSet(vars.getObject('ids'));left.retainAll(s.attempted)
def msg='[IM-BENCH] CLEANUP attempted='+s.attempted.size()+' confirmed='+s.owned.size()+' deleted='+s.deleted.size()+' remaining='+left.size()
log.info(msg);System.out.println(msg)
def ns=System.nanoTime()-s.cleanupStart
def met=ns&lt;=120000000000L &amp;&amp; left.isEmpty() &amp;&amp; s.cleanupQueue!=null &amp;&amp; s.deleted.containsAll(s.owned.keySet())
def goal='[IM-BENCH] CLEANUP_TIME elapsedMs='+ns.intdiv(1000000L)+' targetMs=120000 met='+met
log.info(goal);System.out.println(goal)
if(!left.isEmpty()) throw new IllegalStateException('Run IDs still visible: '+left)</stringProp>
        </JSR223Sampler>
        <hashTree />
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>