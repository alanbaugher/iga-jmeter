            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Check Search numbered namespace" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
if (prev.getResponseCode() != '200') throw new IllegalStateException('Expected HTTP 200')
def doc = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())
def form = doc.selectFirst('form#main')
if (form == null || !form.attr('action').equals('?facesViewId=/app/page/screen/standard_search.jsp')) {
    def forms = doc.select('form[id]').collect { it.id().replaceAll(/[^a-zA-Z0-9_:-]/,'_').take(50) }.take(4)
    def actual = form?.attr('action') ?: ''
    def route = (actual =~ /[?&amp;]facesViewId=(\/app\/[a-zA-Z0-9_\/-]+\.jsp)(?:$|[&amp;#])/)
    def observed = route.find() ? route.group(1) : 'unknown'
    throw new IllegalStateException("Form mismatch | target="+(vars.get('targetUser') ?: 'n/a')+" | HTTP="+prev.getResponseCode()+" | expected=form#main /app/page/screen/standard_search.jsp | observedView="+observed+" | formIds="+forms)
}
def token = form.selectFirst('input[name=OWASP_CSRFTOKEN]')?.val()
if (!token) throw new IllegalStateException('Missing CSRF token')
vars.put('csrf',token)

def p=vars.get('scanPrefix')
def ids=vars.getObject('ids')
def queue=vars.getObject('prefixes')
def rows=form.select('input[name=DefaultUserSearch__sel]')
def nav=form.select('.im-page-nav').first()?.text() ?: ''
def pages=(nav =~ /(?i)(\d+)\s*[-–]\s*(\d+)\s+of\s+(\d+)/)
def limited=pages.find() &amp;&amp; pages.group(2).toInteger()&lt;pages.group(3).toInteger()
def txt=form.text()
if (!limited &amp;&amp; rows.isEmpty() &amp;&amp; !(txt =~ /(?i)(no (?:matching |search )?(?:results|records|users|objects|matches|entries)|0[- ]0 of 0|0 (?:users|records|results)|no .*?found)/).find()) throw new IllegalStateException('Unrecognized empty search result for '+p)
if (!rows.isEmpty() &amp;&amp; !nav &amp;&amp; !txt.contains('1-1 of 1')) throw new IllegalStateException('Cannot verify search result pagination')
if(limited) {
 if(p.length()&gt;='jmeter_test_0000'.length()) throw new IllegalStateException('Ambiguous exact ID '+p)
 (0..9).each { queue.addLast(p+it) }
} else {
 rows.each { el -&gt;
  def row=el.closest('tr')
  def id=row.select('td').get(1).text()
  if(el.attr('title') != 'Select "'+id+'"') throw new IllegalStateException('Search result label mismatch')
  if(id.startsWith(p) &amp;&amp; id ==~ /jmeter_test_(?!0000)[0-9]{4}/) ids.add(id)
 }
}
vars.put('scanMore',String.valueOf(!queue.isEmpty()))

} catch(Exception ex) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(ex.getMessage() ?: 'Form check failed')
}</stringProp>
              </JSR223Assertion>
